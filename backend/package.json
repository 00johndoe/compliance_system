{
  "name": "gh-cybercomply-backend",
  "version": "1.0.0",
  "description": "Node.js + MongoDB backend for the Ghana NCF vs ISO/IEC 27002 Compliance Measurement System (GH-CYBERCOMPLY).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:memory": "USE_MEMORY_DB=true nodemon server.js",
