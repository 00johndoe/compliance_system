# ─── GH-CYBERCOMPLY Backend configuration ───

# HTTP port the API + static frontend are served on
PORT=8000

# MongoDB connection string.
# Local (Homebrew/Docker):   mongodb://127.0.0.1:27017/compliance_system
# MongoDB Atlas (cloud):     mongodb+srv://<user>:<pass>@<cluster>/compliance_system
MONGODB_URI=mongodb://127.0.0.1:27017/compliance_system

# When true, boots an in-memory MongoDB (mongodb-memory-server) instead of
# connecting to MONGODB_URI. Useful for demos / running with zero setup.
# NOTE: in-memory data is NOT persisted across restarts.
USE_MEMORY_DB=false

# Comma-separated list of allowed CORS origins. Use * to allow all.
CORS_ORIGIN=*

# Re-seed reference framework/mapping/gap data on every boot (true/false).
# Reference data is upserted, so this is safe to leave on.
SEED_ON_START=true

# node environment
NODE_ENV=development
